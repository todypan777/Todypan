// ─────────────────────────────────────────────────────────────────────────────
// REGLAS DE FIRESTORE — TodyPan  (FUENTE ÚNICA DE VERDAD)
//
// Este archivo es la copia maestra de las reglas de seguridad. Se despliega por
// CLI con la skill /Actualizar_Reglas_Firebase (firebase.json + .firebaserc),
// cuenta y proyecto explícitos. También se puede pegar a mano en
// Firebase Console → Firestore Database → Reglas → Publicar.
//
// Mantenido por la skill /Actualizar_Reglas_Firebase: cada vez que un cambio
// de código requiera tocar reglas, se edita ESTE archivo y se despliega/entrega.
//
// Última actualización: 2026-09-02 (b) — ALCANCE POR PANADERÍA. Un usuario con
//   `branchIds: [n]` solo lee/escribe documentos de esa sede (sales,
//   cashSessions, inventoryMoves, inventoryStock). Un usuario SIN branchIds
//   NO queda restringido: así, al publicar, el equipo que ya venía trabajando
//   sigue igual y la restricción se activa persona por persona. El correo raíz
//   siempre ve todo. PENDIENTE: /todypan/data sigue compartido (movimientos y
//   saldos de cuentas) y /debtors no tiene branchId.
// Cambio anterior: 2026-09-02 — INVENTARIO de producto terminado: nuevas
//   colecciones `inventoryMoves` (libro de entradas/salidas/ajustes, sin
//   update para nadie: se corrige con otro movimiento) e `inventoryStock`
//   (saldo por producto y panadería). Escritura solo admin, lectura para el
//   equipo aprobado. Sin tocar ninguna regla existente.
// Cambio anterior: 2026-06-06 — la CAJERA dueña del turno de la sede
//   destino puede ATENDER pedidos web: se abre /customerOrders update a
//   isApprovedStaff() (antes solo admin) para que markCustomerOrderConfirmed
//   funcione desde su pantalla. delete sigue solo admin. Sin tocar nada más.
// Cambio anterior: 2026-05-29 — sistema de DESAYUNOS. La regla genérica
//   `match /dailyMenu/{date}` ya cubre el nuevo doc `breakfast_config`
//   (mismo patrón que `corriente_config`), así que ESTRUCTURALMENTE no hubo
//   cambio. kitchenOrders/customerOrders aceptan `kind:'breakfast'` con las
//   mismas condiciones de create/update. Solo se actualizó comentario del
//   bloque /dailyMenu para reflejar el doc nuevo.
// Último cambio: rol MESERA + alineación con el modelo real de roles. Ningún
//   empleado tiene rol permanente: todos son role:'staff' y el rol funcional
//   (caja/cocina/mesera) lo define la sesión (cashSessions.type). Por eso se
//   reemplazan isApprovedCashier()/isApprovedCook() por isApprovedStaff()
//   (empleado aprobado, no admin). La mesera arma mesas/almuerzos que se
//   enganchan a la caja de su panadería: el doc lleva cashierUid = la cajera y
//   ella se identifica con openedByUid/createdByUid. openTabs y kitchenOrders
//   pasan a ser colaborativos entre el equipo aprobado del piso.
// ─────────────────────────────────────────────────────────────────────────────

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdminBootstrap() {
      return request.auth != null
        && request.auth.token.email == 'todypan777@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isAdminUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    function isAdmin() {
      return isAdminBootstrap() || isAdminUser();
    }

    // Empleado APROBADO que no es admin. Acepta el rol nuevo 'staff' y los
    // legacy 'cashier'/'cook' por compatibilidad con docs viejos. El rol
    // FUNCIONAL del día (caja/cocina/mesera) no vive en el doc de usuario sino
    // en la sesión que abre el admin — por eso aquí solo validamos que sea un
    // empleado de confianza aprobado.
    function isApprovedStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'cashier', 'cook'];
    }

    function isApprovedAny() {
      return isAdmin() || isApprovedStaff();
    }

    // ── ALCANCE POR PANADERÍA ─────────────────────────────────────────────
    // Un usuario con `branchIds: [2]` solo puede leer y escribir documentos de
    // esa panadería. Un usuario SIN `branchIds` no tiene restricción y ve todo.
    //
    // Ese default es deliberado: al publicar estas reglas, el dueño anterior y
    // su equipo siguen sin `branchIds` y su app no cambia en nada. La
    // restricción se activa asignándole su panadería a cada persona, una por
    // una — nunca de golpe para todos.
    //
    // El correo raíz (isAdminBootstrap) queda siempre por fuera de la
    // restricción: es quien mantiene el sistema y necesita ver las dos.
    function myBranches() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('branchIds', []);
    }

    // Se pasa la lista ya resuelta para no repetir el get(): cada lectura de
    // documento cuenta contra el tope de accesos por peticion, y isAdmin() /
    // isApprovedStaff() ya gastan varios.
    function listAllows(list, bid) {
      return list.size() == 0 || (bid in list);
    }

    function branchAllowed(bid) {
      return isAdminBootstrap() || listAllows(myBranches(), bid);
    }

    // Aplica sobre el documento existente y, en escrituras, tambien sobre el
    // entrante: sin lo segundo alguien podria MOVER un documento a otra
    // panaderia y sacarlo de su alcance.
    function branchOk() {
      return branchAllowed(resource.data.branchId);
    }

    function newBranchOk() {
      return branchAllowed(request.resource.data.branchId);
    }

    match /users/{uid} {
      allow read: if request.auth != null
                  && (request.auth.uid == uid || isApprovedAny());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update, delete: if isAdmin();
    }

    // El equipo aprobado puede LEER /todypan/data (la cajera y la mesera
    // necesitan branches/products; la cocina necesita branches para dirigir
    // una kitchenCall). Escrituras de datos compartidos: equipo aprobado.
    match /todypan/{doc} {
      allow read: if isApprovedAny();
      allow create, delete: if isAdmin();
      allow update: if isApprovedAny();
    }

    // El equipo aprobado puede LEER /cashSessions: la cocina para saber qué
    // cajera está abierta, y la MESERA para encontrar la caja de su panadería
    // (a la que engancha sus mesas). Crear/cerrar turnos: cajera dueña o admin.
    match /cashSessions/{sid} {
      allow read: if isApprovedAny() && branchOk();
      allow create: if isApprovedStaff()
                    && request.resource.data.cashierUid == request.auth.uid
                    && request.resource.data.status == 'open'
                    && newBranchOk();
      allow update: if ((isApprovedStaff()
                        && resource.data.cashierUid == request.auth.uid
                        && resource.data.status == 'open')
                    || isAdmin()) && branchOk();
      allow delete: if isAdmin() && branchOk();
    }

    match /products/{pid} {
      allow read: if isApprovedAny();
      allow create: if isApprovedStaff()
                    && request.resource.data.createdByCashier == true
                    && request.resource.data.needsCostReview == true;
      allow update: if isApprovedAny();
      allow delete: if isAdmin();
    }

    match /sales/{sid} {
      allow read: if isApprovedAny() && branchOk();
      allow create: if ((isApprovedStaff()
                        && request.resource.data.cashierUid == request.auth.uid)
                    || isAdmin()) && newBranchOk();
      allow update: if ((isApprovedStaff()
                        && resource.data.cashierUid == request.auth.uid)
                    || isAdmin()) && branchOk() && newBranchOk();
      allow delete: if isAdmin() && branchOk();
    }

    match /debtors/{did} {
      allow read: if isApprovedAny();
      allow create, update: if isApprovedAny();
      allow delete: if isAdmin();
    }

    match /cashExpenses/{eid} {
      allow read: if isApprovedAny();
      allow create: if isApprovedStaff()
                    && request.resource.data.cashierUid == request.auth.uid
                    && request.resource.data.status == 'pending';

      // La cajera puede editar SUS gastos mientras sigan 'pending':
      //   - campos de foto (subida diferida offline, igual que antes)
      //   - descripción y monto (corregir antes del cierre)
      // status y cashierUid NO están en hasOnly → no los puede cambiar.
      allow update: if isAdmin()
                    || (isApprovedStaff()
                        && resource.data.cashierUid == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['photoUrl', 'photoStatus', 'photoLocalId',
                                       'photoUploadedAt', 'photoFailedAt',
                                       'photoFailedReason',
                                       'description', 'amount',
                                       'editedAt', 'editedAtClient']));

      // La cajera puede eliminar SUS gastos mientras sigan 'pending'
      // (subió uno por error o duplicado). Aprobado/rechazado lo bloquea el admin.
      allow delete: if isAdmin()
                    || (isApprovedStaff()
                        && resource.data.cashierUid == request.auth.uid
                        && resource.data.status == 'pending');
    }

    // INGRESOS DE CAJA — espejo de cashExpenses. Plata que entra a la caja
    // fuera de las ventas (abono a deuda, préstamo, devolución). La cajera crea
    // y gestiona los suyos mientras sigan 'pending'; el admin aprueba/rechaza al
    // cerrar. El abono a la deuda (si debtorId) lo aplica el admin sobre
    // /debtors (no la cajera) — por eso aquí no se valida nada de deudores.
    match /cashIncomes/{iid} {
      allow read: if isApprovedAny();
      allow create: if isApprovedStaff()
                    && request.resource.data.cashierUid == request.auth.uid
                    && request.resource.data.status == 'pending';

      allow update: if isAdmin()
                    || (isApprovedStaff()
                        && resource.data.cashierUid == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['photoUrl', 'photoStatus', 'photoLocalId',
                                       'photoUploadedAt', 'photoFailedAt',
                                       'photoFailedReason',
                                       'description', 'amount',
                                       'editedAt', 'editedAtClient']));

      allow delete: if isAdmin()
                    || (isApprovedStaff()
                        && resource.data.cashierUid == request.auth.uid
                        && resource.data.status == 'pending');
    }

    match /cashierDeductions/{did} {
      allow read: if request.auth != null
                  && (isAdmin() || resource.data.cashierUid == request.auth.uid);
      allow write: if isAdmin();
    }

    // MESAS abiertas. Modelo colaborativo de piso: la cajera y la(s) mesera(s)
    // de una panadería trabajan sobre las mismas mesas.
    //   - create: el dueño de cobro (cashierUid == quien crea, caso cajera) o
    //     una mesera que se identifica con openedByUid == su uid (el doc lleva
    //     cashierUid = la cajera de la caja para que ella pueda cobrar).
    //   - update/delete: cualquier empleado aprobado (agregar items, cambiar
    //     mesa, cobrar/eliminar). Son datos operativos, no contables.
    match /openTabs/{tid} {
      allow read: if isApprovedAny();
      allow create: if isAdmin()
                    || (isApprovedStaff()
                        && (request.resource.data.cashierUid == request.auth.uid
                            || request.resource.data.openedByUid == request.auth.uid));
      allow update, delete: if isAdmin() || isApprovedStaff();
    }

    match /productChangeRequests/{rid} {
      allow read: if isApprovedAny();
      allow create: if isApprovedStaff()
                    && request.resource.data.cashierUid == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    match /tasks/{tid} {
      allow read: if isAdmin()
                  || (isApprovedStaff()
                      && resource.data.assignedToUid == request.auth.uid);

      allow create: if isAdmin()
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdBy == request.auth.uid;

      allow update: if isAdmin()
                    || (isApprovedStaff()
                        && resource.data.assignedToUid == request.auth.uid
                        && request.resource.data.assignedToUid == resource.data.assignedToUid
                        && request.resource.data.status in ['pending', 'done']
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'completedAt', 'completedAtClient',
                                       'completedInSessionId', 'completedNote']));

      allow delete: if isAdmin();
    }

    // Lectura PÚBLICA (sin auth) para la página /menu de clientes.
    // No expone datos sensibles — son nombres de platos del catálogo.
    // Las escrituras siguen reservadas al equipo (cocina) / admin.
    match /menuItems/{id} {
      allow read: if true;
      allow create, update: if isAdmin() || isApprovedStaff();
      allow delete: if isAdmin();
    }

    // Lectura PÚBLICA (sin auth) para la página /menu de clientes.
    // Cubre los docs por fecha YYYY-MM-DD, `corriente_config` (precios
    // persistentes del almuerzo) y `breakfast_config` (precios + combos
    // del desayuno). Las escrituras siguen reservadas al equipo.
    match /dailyMenu/{date} {
      allow read: if true;
      allow write: if isAdmin() || isApprovedStaff();
    }

    // Pedidos web hechos por clientes desde /menu.
    // - read y create públicos (mismos datos que viajan en el WhatsApp;
    //   public read es necesaria para que el admin abra el link de
    //   confirmación, y para que el cliente vea su propio resumen).
    // - update: admin o empleado aprobado (la cajera dueña del turno de la
    //   sede destino también atiende el pedido → markCustomerOrderConfirmed).
    //   Mismo patrón colaborativo que kitchenOrders/openTabs.
    // - delete: solo admin.
    match /customerOrders/{id} {
      allow read: if true;
      allow create: if true;
      allow update: if isAdmin() || isApprovedStaff();
      allow delete: if isAdmin();
    }

    // ALMUERZOS a cocina. Colaborativo: los crea la cajera, la mesera o el
    // admin (desde el link de pedidos). El doc lleva cashierUid = la cajera de
    // la caja; quien lo originó queda en createdByUid/createdByRole.
    //   - create: admin, o empleado aprobado que se identifica como dueño de
    //     cobro (cashierUid == su uid, caso cajera) o como creador
    //     (createdByUid == su uid, caso mesera).
    //   - update: cualquier empleado aprobado (la cocina marca listo, la cajera
    //     entrega/cancela, la mesera corrige un pedido pending). Operativo.
    match /kitchenOrders/{id} {
      allow read: if isApprovedAny();

      allow create: if (isAdmin()
                        && request.resource.data.status == 'pending')
                    || (isApprovedStaff()
                        && request.resource.data.status == 'pending'
                        && (request.resource.data.cashierUid == request.auth.uid
                            || request.resource.data.createdByUid == request.auth.uid));

      allow update: if isAdmin() || isApprovedStaff();

      allow delete: if isAdmin();
    }

    // Llamadas de cocina a cajera (botón "Llamar cajera" desde la
    // cocina hacia la cajera de Panadería B). Flujo:
    //   - Cocinera/admin crea con status='pending' y se identifica como creador.
    //   - Cajera destino la lee (filtrada por targetCashierUid) y solo
    //     puede marcarla 'acknowledged' (cerrar el pop-up).
    //   - La cocinera creadora también puede marcar su propia llamada como
    //     'cancelled' para abortarla antes de que la cajera atienda.
    //   - Admin tiene control total para auditoría.
    match /kitchenCalls/{cid} {
      allow read: if isAdmin()
                  || (isApprovedStaff()
                      && (resource.data.createdBy == request.auth.uid
                          || resource.data.targetCashierUid == request.auth.uid));

      allow create: if (isApprovedStaff() || isAdmin())
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.status == 'pending';

      allow update: if isAdmin()
                    || (isApprovedStaff()
                        && resource.data.targetCashierUid == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'acknowledged'
                        && request.resource.data.targetCashierUid == resource.data.targetCashierUid
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'acknowledgedAt', 'acknowledgedAtClient',
                                       'acknowledgedBy', 'acknowledgedByName']))
                    || (isApprovedStaff()
                        && resource.data.createdBy == request.auth.uid
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'cancelled'
                        && request.resource.data.createdBy == resource.data.createdBy
                        && request.resource.data.diff(resource.data).affectedKeys()
                             .hasOnly(['status', 'cancelledAt', 'cancelledAtClient',
                                       'cancelledBy', 'cancelledByName']));

      allow delete: if isAdmin();
    }

    // ── INVENTARIO DE PRODUCTO TERMINADO ──────────────────────────────────
    // Dos colecciones: `inventoryMoves` es el LIBRO (entradas, salidas y
    // ajustes) e `inventoryStock` el SALDO derivado por producto y panaderia.
    //
    // Hoy solo el admin registra movimientos — asi lo pidio el dueño. La
    // lectura si queda abierta al equipo aprobado para que mañana la cajera
    // pueda ver existencias desde el POS sin tocar reglas.
    //
    // Un movimiento NO se edita: `update` esta negado para todos, incluido el
    // admin. Una correccion se hace con otro movimiento (un ajuste), de modo
    // que el libro conserve el rastro de que se corrigio y quien lo hizo.
    // `delete` queda solo para el admin, como salida de emergencia ante un
    // registro claramente erroneo.
    match /inventoryMoves/{mid} {
      allow read:   if isApprovedAny() && branchOk();
      allow create: if isAdmin() && newBranchOk()
                    && request.resource.data.delta is number
                    && request.resource.data.delta != 0;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // El saldo lo escribe la misma operacion que crea el movimiento, con
    // increment() del lado del servidor.
    match /inventoryStock/{sid} {
      allow read:  if isApprovedAny() && branchOk();
      allow write: if isAdmin() && newBranchOk();
    }

    // ── MOVIMIENTOS (ingresos y gastos del administrador) ─────────────────
    // Antes vivían dentro de /todypan/data, un documento único: las reglas
    // aplican por documento COMPLETO, así que era imposible darle a un dueño
    // solo su parte. Aquí cada movimiento es su propio documento y sí se puede
    // separar por panadería.
    //
    // El campo se llama `branch` (no `branchId`), por eso no sirven branchOk()
    // ni newBranchOk() y se llama a branchAllowed directamente.
    match /movements/{mid} {
      allow read:   if isApprovedAny() && branchAllowed(resource.data.branch);
      allow create: if isAdmin() && branchAllowed(request.resource.data.branch);
      allow update: if isAdmin()
                    && branchAllowed(resource.data.branch)
                    && branchAllowed(request.resource.data.branch);
      allow delete: if isAdmin() && branchAllowed(resource.data.branch);
    }

    // SALDO CORRIENTE POR CUENTA. Evita recorrer todo el libro para saber
    // cuánto hay en Nequi o Daviplata; se actualiza con increment() al
    // registrar o borrar un movimiento.
    //
    // PENDIENTE: las cuentas todavía son compartidas entre las dos panaderías,
    // así que este saldo mezcla el dinero de ambas. Es la misma exposición que
    // ya existía (el cálculo anterior tampoco filtraba por sede), pero separar
    // las cuentas por panadería sigue en la lista.
    match /accountBalances/{aid} {
      allow read:  if isApprovedAny();
      allow write: if isAdmin();
    }

    // TURNOS PROGRAMADOS. No tenía regla propia: vivía del comodín de abajo,
    // que ahora es solo del correo raíz. Sin este bloque, programar turnos
    // dejaría de funcionar para cualquier otro admin.
    //
    // La escritura sí valida la panadería. La LECTURA queda sin restringir a
    // propósito: `watchShiftsForDate` consulta por fecha sin filtrar sede, y
    // scoping la lectura sin tocar esa consulta daría permission-denied y
    // rompería la pantalla de Equipo. Es un horario de trabajo, no plata; se
    // cierra en la etapa siguiente junto con el resto.
    match /scheduledShifts/{sid} {
      allow read:   if isApprovedAny();
      allow create: if isAdmin() && newBranchOk();
      allow update: if isAdmin() && branchOk() && newBranchOk();
      allow delete: if isAdmin() && branchOk();
    }

    // Comodín de cierre. SOLO el correo raíz, nunca isAdmin().
    //
    // En Firestore, cuando varias reglas coinciden con una ruta, el acceso se
    // concede si CUALQUIERA lo permite. Este bloque coincide con todas las
    // rutas, incluida /sales: con `isAdmin()` aquí, un admin restringido a su
    // panadería recuperaba por esta puerta el acceso a la otra, y todo el
    // alcance por panadería quedaba en nada.
    //
    // Cada colección real ya tiene su regla explícita arriba, así que esto solo
    // cubre rutas nuevas todavía sin reglas propias — y ahí conviene que llegue
    // únicamente quien mantiene el sistema.
    match /{document=**} {
      allow read, write: if isAdminBootstrap();
    }
  }
}
